\theoremstyle{plain}
\newtheorem{theorem}{Теорема}[section]
\newtheorem*{theorem*}{Теорема}
\newtheorem{lemma}{Лемма}[section]
\newtheorem*{lemma*}{Лемма}
\newtheorem{corollary}{Следствие}[section]
\newtheorem*{corollary*}{Следствие}
\newtheorem{statement}{Утверждение}[section]
\newtheorem*{statement*}{Утверждение}

\theoremstyle{definition}
\newtheorem{definition}{Определение}[section]
\newtheorem*{definition*}{Определение}
\newtheorem{example}{Пример}[section]
\newtheorem*{example*}{Пример}

\renewcommand{\proofname}{Доказательство}
\renewcommand{\qedsymbol}{\(\blacksquare\)}

\newcommand{\notes@wrap}[3]{%
    \if\relax\detokenize{#2}\relax
        \begin{#1}#3\end{#1}%
    \else
        \begin{#1}[#2]#3\end{#1}%
    \fi
}

\newcommand{\thm}{\@ifstar{\notes@wrap{theorem*}}{\notes@wrap{theorem}}}
\newcommand{\lem}{\@ifstar{\notes@wrap{lemma*}}{\notes@wrap{lemma}}}
\newcommand{\coroll}{\@ifstar{\notes@wrap{corollary*}}{\notes@wrap{corollary}}}
\newcommand{\stat}{\@ifstar{\notes@wrap{statement*}}{\notes@wrap{statement}}}
\newcommand{\dfn}{\@ifstar{\notes@wrap{definition*}}{\notes@wrap{definition}}}
\newcommand{\ex}{\@ifstar{\notes@wrap{example*}}{\notes@wrap{example}}}
\newcommand{\notes@proof}[1]{\begin{proof}#1\end{proof}}
\newcommand{\prf}{\@ifstar{\notes@proof}{\notes@proof}}

% Упражнение: мелкий отступной блок, не наравне с теоремой
\newcounter{exercise}[section]
\renewcommand{\theexercise}{\thesection.\arabic{exercise}}
\newcommand{\notes@exercise@begin}{%
    \par\addvspace{8pt}%
    \begin{list}{}{%
        \small
        \setlength{\leftmargin}{0pt}%
        \setlength{\rightmargin}{0pt}%
        \setlength{\labelwidth}{0pt}%
        \setlength{\labelsep}{0pt}%
        \setlength{\itemindent}{0pt}%
        \setlength{\listparindent}{0pt}%
        \setlength{\parsep}{2pt}%
        \setlength{\itemsep}{0pt}%
        \setlength{\topsep}{2pt}%
        \setlength{\partopsep}{0pt}%
    }%
    \item\relax
}
\newcommand{\notes@exercise@body}[2]{%
    \if\relax\detokenize{#1}\relax\else
        \ \textit{#1.}%
    \fi
    \ \upshape #2\par
    \end{list}%
    \addvspace{6pt}%
}
\newcommand{\notes@exercise}[2]{%
    \notes@exercise@begin
    \refstepcounter{exercise}%
    \textit{Упр.~\theexercise.}%
    \notes@exercise@body{#1}{#2}%
}
\newcommand{\notes@exercise@star}[2]{%
    \notes@exercise@begin
    \textit{Упр.}%
    \notes@exercise@body{#1}{#2}%
}
\newcommand{\exr}{\@ifstar{\notes@exercise@star}{\notes@exercise}}

% Замечания: обычные --- жирный заголовок;
% Напоминание / Отступление --- тонкая чёрная полоска слева
\newtcolorbox{notebox}{%
    enhanced,
    breakable,
    lines before break=12,
    frame hidden,
    boxrule=0pt,
    colback=white,
    borderline west={1.7pt}{0pt}{black},
    sharp corners,
    left=11pt,
    right=4pt,
    top=5pt,
    bottom=5pt,
    before skip=10pt,
    after skip=10pt,
}

\newcommand{\notes@remarktitle}[1]{%
    \if\relax\detokenize{#1}\relax
        \textbf{Замечание.}\ %
    \else
        \textbf{#1.}\ %
    \fi
}

\newcommand{\notes@remarkplain}[2]{%
    \par\vspace{10pt}%
    \noindent\notes@remarktitle{#1}#2\par
    \vspace{10pt}%
}

\newcommand{\notes@remarkboxed}[2]{%
    \begin{notebox}\notes@remarktitle{#1}#2\end{notebox}%
}

\ExplSyntaxOn
\newcommand{\notes@ifsidebar}[3]{%
    \bool_if:nTF
      {
        \str_if_eq_p:ee { \tl_trim_spaces:n {#1} } {Напоминание}
        ||
        \str_if_eq_p:ee { \tl_trim_spaces:n {#1} } {Отступление}
      }
      {#2} {#3}
}
\ExplSyntaxOff

\newcommand{\notes@rem}[2]{%
    \notes@ifsidebar{#1}
        {\notes@remarkboxed{#1}{#2}}
        {\notes@remarkplain{#1}{#2}}%
}
\newcommand{\rem}{\@ifstar{\notes@rem}{\notes@rem}}
\newcommand{\remm}{\@ifstar{\notes@rem}{\notes@rem}}

